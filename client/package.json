{
  "name": "classifarr-client",
  "version": "0.41.1-alpha",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=10.0.0"
  },
  "description": "Classifarr frontend application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node ./scripts/run-vitest.mjs run",
    "test:unit": "node ./scripts/run-vitest.mjs run --dir src/__tests__",
    "test:coverage": "node ./scripts/run-vitest.mjs run --coverage",
    "test:ui": "node ./scripts/run-vitest.mjs --ui",
    "test:watch": "node ./scripts/run-vitest.mjs",
    "test:ci": "node ./scripts/run-vitest.mjs run --coverage --reporter=verbose"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@vueuse/core": "^14.2.0",
    "axios": "^1.13.4",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}

