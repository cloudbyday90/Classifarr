{
  "name": "classifarr-client",
  "version": "0.45.1-beta",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=10.0.0"
  },
  "description": "Classifarr frontend application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "node ./scripts/run-vitest.mjs run",
    "test:unit": "node ./scripts/run-vitest.mjs run --dir src/__tests__",
    "test:coverage": "node ./scripts/run-vitest.mjs run --coverage",
    "test:ui": "node ./scripts/run-vitest.mjs --ui",
    "test:watch": "node ./scripts/run-vitest.mjs",
    "test:ci": "node ./scripts/run-vitest.mjs run --coverage --reporter=verbose"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.6",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "~10.4.0",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "minimatch": "10.2.4",
    "brace-expansion": "5.0.5"
  }
}
