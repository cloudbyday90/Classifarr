{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"],
    "jsx": "preserve",
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "ignoreDeprecations": "6.0",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src/api/**/*.js", "src/api/**/*.d.ts", "src/utils/csrf.js", "src/env.d.ts", "vite.config.js", "vitest.config.js", "vitest.setup.js"],
  "exclude": ["src/__tests__/**", "coverage/**", "dist/**"]
}
