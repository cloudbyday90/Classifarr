# Set default behavior to automatically normalize line endings
* text=auto

# Source code - always use LF
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf

# Config/data files - always use LF
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Environment/runtime markers - always use LF
.env.example text eol=lf
.nvmrc text eol=lf
LICENSE text eol=lf

# Web files - always use LF
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.svg text eol=lf

# Markup/templates - always use LF
*.xml text eol=lf

# Documentation - always use LF
*.md text eol=lf
*.txt text eol=lf
*.backup text eol=lf

# Database files - always use LF
*.sql text eol=lf
*.bak text eol=lf

# Shell scripts must always use LF
*.sh text eol=lf
*.bash text eol=lf

# Ensure docker-entrypoint.sh specifically uses LF
docker-entrypoint.sh text eol=lf

# Docker files - always use LF
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf

# Editor/IDE config
.editorconfig text eol=lf
.eslintrc* text eol=lf
.prettierrc* text eol=lf
*.code-snippets text eol=lf

# Binary files - don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

