{
    "css.validate": false,
    "scss.validate": false,
    "less.validate": false,
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "tailwindCSS.includeLanguages": {
        "vue": "html"
    },
    "editor.quickSuggestions": {
        "strings": true
    },
    "files.exclude": {
        "**/.tmp/**": true
    },
    "search.exclude": {
        "**/.tmp/**": true
    }
}
