{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:classifarr:policy-candidate-semantic-snapshot:v1",
  "title": "Classifarr Policy Candidate Semantic Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "snapshotSetId",
    "embeddingSpaceId",
    "snapshots"
  ],
  "properties": {
    "version": {
      "const": "policy.candidate_semantic_snapshot_document.v1"
    },
    "snapshotSetId": {
      "$ref": "#/$defs/snapshotId"
    },
    "embeddingSpaceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    }
  },
  "$defs": {
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "embedding": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      }
    },
    "candidateEmbedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleId", "embedding"],
      "properties": {
        "roleId": {
          "enum": ["leading", "alternative"]
        },
        "embedding": {
          "$ref": "#/$defs/embedding"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "fixtureId",
        "queryEmbedding",
        "candidateEmbeddings"
      ],
      "properties": {
        "version": {
          "const": "policy.candidate_semantic_snapshot.v1"
        },
        "id": {
          "$ref": "#/$defs/snapshotId"
        },
        "fixtureId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "queryEmbedding": {
          "$ref": "#/$defs/embedding"
        },
        "candidateEmbeddings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/candidateEmbedding"
          }
        }
      }
    }
  }
}
