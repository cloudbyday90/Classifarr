{
  "name": "classifarr-server",
  "version": "0.42.5d-alpha",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=10.0.0"
  },
  "description": "AI-powered media classification for the *arr ecosystem",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node ./scripts/run-jest.mjs --runInBand",
    "test:unit": "node ./scripts/run-jest.mjs",
    "test:integration": "node ./scripts/run-jest.mjs -c jest.integration.config.js --runInBand",
    "test:coverage": "node ./scripts/run-jest.mjs --coverage",
    "test:coverage:unit": "node ./scripts/run-jest.mjs --testPathPattern=__tests__/unit --coverage",
    "test:coverage:integration": "node ./scripts/run-jest.mjs -c jest.integration.config.js --coverage",
    "test:watch": "node ./scripts/run-jest.mjs --watch",
    "test:ci": "node ./scripts/run-jest.mjs --ci --coverage --maxWorkers=2",
    "lint:tests": "eslint \"src/__tests__/**/*.js\"",
    "check-copyright": "node ../scripts/check-copyright.js",
    "update-copyright": "node ../scripts/update-copyright.js",
    "generate-contributors": "node ../scripts/generate-contributors.js"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "pg": "^8.18.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.11.0",
    "eslint": "10.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "pg-mem": "^3.0.12",
    "supertest": "^7.2.2",
    "testcontainers": "^11.11.0"
  },
  "overrides": {
    "undici": ">=6.23.0",
    "glob": ">=10.0.0",
    "minimatch": ">=10.2.1"
  }
}
