{
  "name": "classifarr-server",
  "version": "0.47.5-c.beta",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=10.0.0"
  },
  "description": "AI-powered media classification for the *arr ecosystem",
  "main": "src/index.mjs",
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "nodemon src/index.mjs",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "node ./scripts/run-jest.mjs --runInBand && node ./scripts/run-jest.mjs -c jest.integration.config.mjs --runInBand",
    "test:unit": "node ./scripts/run-jest.mjs --runInBand",
    "test:bail": "node ./scripts/run-jest.mjs --runInBand --bail=1 --no-coverage",
    "test:integration": "node ./scripts/run-jest.mjs -c jest.integration.config.mjs --runInBand",
    "test:coverage": "node ./scripts/run-jest.mjs --coverage",
    "test:coverage:unit": "node ./scripts/run-jest.mjs --coverage",
    "test:coverage:integration": "node ./scripts/run-jest.mjs -c jest.integration.config.mjs --coverage",
    "test:watch": "node ./scripts/run-jest.mjs --watch",
    "test:ci": "npm run typecheck && node ./scripts/run-jest.mjs --ci --coverage --maxWorkers=2",
    "lint": "npm run lint:tests && npm run lint:security",
    "lint:tests": "eslint \"src/__tests__/**/*.{js,mjs}\"",
    "lint:security": "eslint \"src/**/*.{js,mjs}\" --ignore-pattern \"src/__tests__/**\"",
    "lint:knip": "knip --reporter compact --no-progress --cache",
    "lint:knip:production": "knip --reporter compact --no-progress --cache --production --dependencies",
    "check-copyright": "node ../scripts/check-copyright.mjs",
    "update-copyright": "node ../scripts/update-copyright.mjs",
    "generate-contributors": "node ../scripts/generate-contributors.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "js-yaml": "^4.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "knip": "^6.32.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "13.0.6",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "body-parser": "2.3.0",
    "engine.io": "6.6.9",
    "js-yaml": "^4.3.0",
    "json-parse-even-better-errors": "5.0.0",
    "lines-and-columns": "2.0.4",
    "path-exists": "5.0.0",
    "path-key": "4.0.0",
    "which": "6.0.1",
    "source-map-support": "0.5.21",
    "strip-json-comments": "5.0.3",
    "ws": "^8.21.0",
    "safe-buffer": "5.2.1",
    "mime-db": "1.54.0",
    "asynckit": "0.5.0",
    "ms": "2.1.3",
    "on-finished": "2.4.1",
    "path-to-regexp": "8.4.2",
    "retry": "0.13.1",
    "immutable": ">=4.3.8",
    "uuid": "^14.0.0",
    "qs": ">=6.15.2",
    "ip-address": "10.4.0",
    "socket.io-parser": "4.2.7",
    "discord.js": {
      "undici": "6.28.0"
    },
    "@discordjs/rest": {
      "undici": "6.28.0"
    }
  }
}
