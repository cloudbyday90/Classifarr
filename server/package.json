{
  "name": "classifarr-server",
  "version": "0.43.7a-beta",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=10.0.0"
  },
  "description": "AI-powered media classification for the *arr ecosystem",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node ./scripts/run-jest.mjs --runInBand",
    "test:unit": "node ./scripts/run-jest.mjs",
    "test:integration": "node ./scripts/run-jest.mjs -c jest.integration.config.js --runInBand",
    "test:coverage": "node ./scripts/run-jest.mjs --coverage",
    "test:coverage:unit": "node ./scripts/run-jest.mjs --coverage",
    "test:coverage:integration": "node ./scripts/run-jest.mjs -c jest.integration.config.js --coverage",
    "test:watch": "node ./scripts/run-jest.mjs --watch",
    "test:ci": "node ./scripts/run-jest.mjs --ci --coverage --maxWorkers=2",
    "lint:tests": "eslint \"src/__tests__/**/*.js\"",
    "lint:security": "eslint \"src/**/*.js\" --ignore-pattern \"src/__tests__/**\"",
    "check-copyright": "node ../scripts/check-copyright.js",
    "update-copyright": "node ../scripts/update-copyright.js",
    "generate-contributors": "node ../scripts/generate-contributors.js"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.12.0",
    "eslint": "^10.0.2",
    "eslint-plugin-security": "^4.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.13",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "testcontainers": "^11.12.0"
  },
  "overrides": {
    "undici": ">=6.23.0",
    "glob": ">=10.0.0",
    "minimatch": "10.2.3",
    "immutable": ">=4.3.8"
  }
}
