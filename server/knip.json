{
  "$schema": "https://raw.githubusercontent.com/webpro-nl/knip/main/schema.json",
  "entry": ["src/index.mjs"],
  "project": ["src/**/*.mjs", "scripts/**/*.mjs"],
  "ignore": [
    "src/__tests__/**",
    "jest.*.mjs",
    "scripts/fix-duplicate-db-mocks.mjs",
    "scripts/migrate-database-mocks.mjs",
    "scripts/migrate-queue-wrappers.mjs"
  ],
  "ignoreDependencies": [
    "@jest/globals",
    "body-parser",
    "@testcontainers/postgresql",
    "@eslint/js",
    "eslint-plugin-n",
    "eslint-plugin-security",
    "globals",
    "typescript",
    "nodemon",
    "supertest",
    "glob",
    "jest",
    "pino-roll"
  ],
