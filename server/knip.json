{
  "$schema": "https://raw.githubusercontent.com/webpro-nl/knip/main/schema.json",
  "entry": ["src/scripts/**/*.mjs"],
  "project": ["src/**/*.mjs!", "scripts/**/*.mjs"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error",
    "binaries": "error"
  },
  "ignore": [
    "src/__tests__/**",
    "scripts/fix-duplicate-db-mocks.mjs",
    "scripts/migrate-database-mocks.mjs",
    "scripts/migrate-queue-wrappers.mjs"
  ],
  "ignoreDependencies": [
    "@eslint/js",
    "@testcontainers/postgresql",
    "jest",
    "pino-roll",
    "socket.io"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/utils/cliRuntime.mjs": ["files"],
    "src/services/webSocketService.mjs": ["files"],
    "src/services/classificationEvidenceMigrationBackfillService.mjs": ["files"],
    "src/services/classificationEvidenceMigrationVerificationService.mjs": ["files"],
    "src/services/tavilyProviderClient.mjs": ["exports", "files"],
    "src/services/tavilyWebSearchProvider.mjs": ["exports", "files"],
    "src/services/webSearchProviderContract.mjs": ["exports", "files"],
    "src/services/webSearchProviderErrorTaxonomy.mjs": ["files"],
    "src/services/webSearchProviderStorage.mjs": ["exports", "files"]
  }
}
