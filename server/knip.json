{
  "$schema": "https://raw.githubusercontent.com/webpro-nl/knip/main/schema.json",
  "entry": ["src/index.mjs!", "src/scripts/**/*.mjs"],
  "project": ["src/**/*.mjs!", "scripts/**/*.mjs"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error",
    "binaries": "error"
  },
  "ignore": [
    "src/__tests__/**",
    "jest.*.mjs",
    "scripts/fix-duplicate-db-mocks.mjs",
    "scripts/migrate-database-mocks.mjs",
    "scripts/migrate-queue-wrappers.mjs"
  ],
  "ignoreDependencies": [
    "@jest/globals",
    "body-parser",
    "@testcontainers/postgresql",
    "@eslint/js",
    "eslint-plugin-n",
    "eslint-plugin-security",
    "globals",
    "typescript",
    "nodemon",
    "supertest",
    "jest",
    "pino-roll",
    "socket.io"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/utils/cliRuntime.mjs": ["exports"],
    "src/services/ragGraphExtractor.mjs": ["exports"],
    "src/utils/classificationRetryPayloads.mjs": ["exports"],
    "src/services/webSocketService.mjs": ["files"],
    "src/services/classificationEvidenceMigrationBackfillService.mjs": ["files"],
    "src/services/classificationEvidenceMigrationVerificationService.mjs": ["files"]
  }
}
