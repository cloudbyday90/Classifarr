{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "src/routes/helpers/aiSettingsHandlers.mjs",
    "src/routes/helpers/aiSettingsPersistence.mjs",
    "src/routes/helpers/aiSettingsConfigSupport.mjs",
    "src/routes/helpers/aiSettingsResponseSupport.mjs",
    "src/routes/helpers/settingsRuntimeRefreshSupport.mjs",
    "src/routes/helpers/settingsErrorSupport.mjs",
    "src/services/aiSettingsActionService.mjs",
    "src/services/discordSettingsActionService.mjs",
    "src/services/mediaSync.mjs",
    "src/services/shared/settingsServiceErrors.mjs",
    "src/services/shared/aiSettingsRequestSupport.mjs",
    "src/services/mediaServers/index.mjs",
    "src/services/shared/runtimeWiringValidation.mjs",
    "src/utils/errors.mjs",
    "src/utils/metadataNormalization.mjs",
    "src/services/webhookSettingsActionService.mjs",
    "src/services/webhookSettingsMutationService.mjs"
  ],
  "exclude": ["src/__tests__/**", "coverage/**"]
}
