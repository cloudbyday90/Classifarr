# ===========================================
# CLASSIFARR CONFIGURATION
# ===========================================

# Database
# For Docker Compose, these are typically managed by the compose file and persisted in volumes.
# For local development (non-Docker), set these to point at your Postgres instance.
# DATABASE_URL=postgres://classifarr:password@localhost:5432/classifarr
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=classifarr
# POSTGRES_USER=classifarr
# POSTGRES_PASSWORD=

# API Key Encryption (IMPORTANT for production)
# Set this to persist API keys across server restarts
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, API keys become invalid on restart
# API_KEY_ENCRYPTION_KEY=
# Optional file path fallback when API_KEY_ENCRYPTION_KEY is unset.
# Default: /app/data/secrets/api_key_encryption_key (persisted on Docker volume)
# API_KEY_ENCRYPTION_KEY_FILE=/app/data/secrets/api_key_encryption_key

# Security headers strict mode
# true  = allow strict browser isolation headers when ENFORCE_HTTPS_HEADERS=true
# false = always disable COOP/OAC browser isolation headers
# SECURITY_HEADERS_STRICT=true

# CORS origin restriction (IMPORTANT for production)
# Comma-separated list of allowed origins, or leave empty to allow all (not recommended for production)
# Example: CORS_ORIGIN=https://classifarr.example.com,https://internal.example.com
# CORS_ORIGIN=
#
# Runtime JSON equivalent key: cors_origin
# Example in /app/data/config/runtime.json:
#   "cors_origin": "https://classifarr.example.com,https://internal.example.com"
# If null/empty, all origins are allowed.

# Cookie/CSRF security
# Set to true only when your deployment is served over HTTPS.
# Keep false for local/LAN HTTP-only deployments.
# FORCE_SECURE_COOKIES=false
#
# CSRF protection for cookie-authenticated write requests.
# Recommended true in all environments (works with local HTTP).
# CSRF_PROTECTION=true
#
# Optional runtime settings file path (JSON)
# Supports keys like:
#   force_secure_cookies, csrf_protection, cors_origin,
#   omdb_request_timeout_ms, omdb_retry_timeout_multiplier,
#   omdb_max_request_timeout_ms, omdb_max_retries, omdb_ssl_warn_throttle_ms
# Precedence: DB/UI setting > runtime JSON > env var > default
# RUNTIME_SETTINGS_FILE=/app/data/config/runtime.json

# Optional: enforce HTTPS-only browser headers from Classifarr itself
# Default false for local HTTP compatibility; enable only when served via HTTPS.
# Also enables COOP/OAC browser isolation headers when SECURITY_HEADERS_STRICT=true.
# ENFORCE_HTTPS_HEADERS=false

# OMDb SSL resilience tuning (milliseconds, optional overrides)
# Code defaults are now implemented in-app (runtime.json/DB/env can override).
# When OMDb cert validation fails, Classifarr will:
# 1) throttle repeated SSL warning logs,
# 2) pause direct OMDb calls for a short block window,
# 3) probe for recovery and auto-resume when healthy.
# OMDb request timeout for each API call (default 30000)
# OMDB_REQUEST_TIMEOUT_MS=30000
# Retry attempts can use progressively higher timeouts.
# Retry timeout = min(OMDB_REQUEST_TIMEOUT_MS * multiplier^attempt, OMDB_MAX_REQUEST_TIMEOUT_MS)
# OMDB_RETRY_TIMEOUT_MULTIPLIER=2
# OMDB_MAX_REQUEST_TIMEOUT_MS=60000
# Number of total attempts for transient OMDb errors (default 3)
# OMDB_MAX_RETRIES=3
# OMDB_SSL_WARN_THROTTLE_MS=900000
# OMDB_SSL_BLOCK_MS=900000
# OMDB_SSL_RECOVERY_PROBE_MS=60000

# Ollama scheduled preflight resilience tuning (optional overrides)
# Connectivity probe timeout for /api/tags (default 5000)
# OLLAMA_CONNECTIVITY_TIMEOUT_MS=5000
# Generation readiness probe timeout for /api/generate (default 120000 / 2 minutes; covers cold model loads)
# OLLAMA_PROBE_TIMEOUT_MS=120000
# Retry base delay after a failed scheduled preflight (default 300000 / 5 minutes)
# OLLAMA_PREFLIGHT_RETRY_BASE_MS=300000
# Maximum retry delay cap for scheduled preflight backoff (default 3600000 / 1 hour)
# OLLAMA_PREFLIGHT_RETRY_MAX_MS=3600000
# Dedupe window for repeated scheduled preflight WARN logs (default 1800000 / 30 minutes)
# OLLAMA_PREFLIGHT_WARN_DEDUPE_MS=1800000

# All other configuration is done through the web UI after setup

# Connection pool tuning
# Max pool connections (default 15; each concurrent task can hold 1+ connections during vector/graph queries)
# Raise if you see "timeout exceeded when trying to connect" under heavy classification load.
# POSTGRES_POOL_MAX=15
# Time (ms) to wait for a pool connection before failing a query (default 5000)
# POSTGRES_CONN_TIMEOUT_MS=5000
# Kill runaway queries after this many ms (default 30000)
# POSTGRES_STATEMENT_TIMEOUT_MS=30000
# Bounded retry for transient connection-acquisition failures (e.g. "Connection
# terminated due to connection timeout" during startup bursts). Only the
# idempotent connect step is retried, never query execution.
# POSTGRES_CONNECT_RETRIES=2
# Base backoff (ms) between connection-acquisition retries; doubles each attempt (default 250)
# POSTGRES_CONNECT_RETRY_DELAY_MS=250

# Slow query logging threshold in milliseconds (default: 500)
# POSTGRES_SLOW_QUERY_THRESHOLD_MS=500

# Controlled named-scope compatibility retirement admission (server-only).
# This is intentionally not exposed as a general HTTP endpoint. Configure only
# for an explicit server-owned retirement workflow. Both roots must be absolute;
# the evidence root must be outside the source repository. Authorization TTL is
# bounded from 1000 to 1800000 ms (default: 300000 / 5 minutes).
# POLICY_COMPATIBILITY_NAMED_SCOPE_REPOSITORY_ROOT=/workspace/Classifarr
# POLICY_COMPATIBILITY_NAMED_SCOPE_EVIDENCE_ROOT=/var/lib/classifarr/controlled-removal-evidence
# POLICY_COMPATIBILITY_NAMED_SCOPE_AUTHORIZATION_TTL_MS=300000

# task_queue finished-row retention safety valve.
# Classifarr keeps recent completed/failed/cancelled tasks for troubleshooting,
# but trims oldest finished rows when the table exceeds this cap.
# Default in code: 10000
# TASK_QUEUE_MAX_TOTAL_ROWS=10000

# Fallback number of days to retain completed task_queue rows before scheduled cleanup.
# The operator-managed settings row `task_queue_retention_days` takes precedence when present.
# Set to 0 to disable age-based cleanup for completed rows while keeping the count-cap safety valve active.
# Default fallback: 7
# TASK_QUEUE_RETENTION_DAYS=7

# Fallback number of days to retain failed task_queue rows before scheduled cleanup.
# The operator-managed settings row `task_queue_failed_retention_days` takes precedence when present.
# Failed rows default longer than completed rows because they are more useful for debugging.
# Set to 0 to disable age-based cleanup for failed rows while keeping the count-cap safety valve active.
# Default fallback: 30
# TASK_QUEUE_FAILED_RETENTION_DAYS=30

# Fallback number of days to retain cancelled task_queue rows before scheduled cleanup.
# The operator-managed settings row `task_queue_cancelled_retention_days` takes precedence when present.
# Cancelled rows default shorter than completed rows because they are usually lower-value history.
# Set to 0 to disable age-based cleanup for cancelled rows while keeping the count-cap safety valve active.
# Default fallback: 3
# TASK_QUEUE_CANCELLED_RETENTION_DAYS=3

# pgvector HNSW retrieval recall tuning.
# Higher ef_search and candidate limits improve recall at the cost of query latency.
# Defaults favor policy/re-check recall over minimal latency while staying bounded for embedded PostgreSQL.
# Runtime pgvector binary staging policy.
# auto: stage a vector.so symlink to the immutable image-layer AVX/AVX2 binary when supported.
# disabled: force the image-layer generic vector.so.
# PGVECTOR_RUNTIME_STAGING=auto
# Main semantic searches (default: 80, clamp range: 40-1000)
# PGVECTOR_EF_SEARCH=80
# Candidate-gathering searches for RAG loop/policy re-checks (default: 100, clamp range: 40-1000)
# PGVECTOR_EF_SEARCH_CANDIDATES=100
# Vector rows considered before final threshold/combined scoring (default min 50, multiplier 10, max 200)
# PGVECTOR_CANDIDATE_LIMIT_MIN=50
# PGVECTOR_CANDIDATE_LIMIT_MULTIPLIER=10
# PGVECTOR_CANDIDATE_LIMIT=200
# pgvector 0.8+ iterative HNSW scans: off, strict_order, relaxed_order (default: relaxed_order)
# PGVECTOR_HNSW_ITERATIVE_SCAN=relaxed_order
# Optional advanced HNSW iterative-scan caps. Leave unset unless diagnosing recall/latency tradeoffs.
# PGVECTOR_HNSW_MAX_SCAN_TUPLES=
# PGVECTOR_HNSW_SCAN_MEM_MULTIPLIER=

# Advanced replay preview switch. Default false keeps representative policy
# replay from making live TMDB calls. When true, replay still requires an
# explicit request opt-in and TMDB provider readiness/quota safety before a
# bounded sanitized metadata preview can execute.
# POLICY_INTENT_REPLAY_TMDB_METADATA_LIVE_PREVIEW_ENABLED=false

# Set to 'false' to disable automatic expired refresh token cleanup (default: true)
# REFRESH_TOKEN_CLEANUP_ENABLED=true

# Number of days to retain api_key_audit rows before pruning (default: 90)
# API_AUDIT_RETENTION_DAYS=90
# Access the UI at http://localhost:21324 after starting the containers
