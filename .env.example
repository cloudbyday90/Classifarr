# ===========================================
# CLASSIFARR CONFIGURATION
# ===========================================

# Database
# For Docker Compose, these are typically managed by the compose file and persisted in volumes.
# For local development (non-Docker), set these to point at your Postgres instance.
# DATABASE_URL=postgres://classifarr:password@localhost:5432/classifarr
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=classifarr
# POSTGRES_USER=classifarr
# POSTGRES_PASSWORD=

# API Key Encryption (IMPORTANT for production)
# Set this to persist API keys across server restarts
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, API keys become invalid on restart
# API_KEY_ENCRYPTION_KEY=

# ===========================================
# Issue 285 (Fine-Tuned Retriever / Model Updates) - Reserved
# ===========================================
# These placeholders will be wired up as Issue 285 is implemented.
# They are NOT required for normal operation today.

# Path to a JSON file containing trusted signing public keys (for model manifest verification).
# EMBEDDING_TRUSTED_KEYS_PATH=/app/data/keys/embedding-trusted-keys.json

# Optional default manifest URL for the updater (can be overridden by UI/DB config later).
# EMBEDDING_MANIFEST_URL=

# All other configuration is done through the web UI after setup
# Access the UI at http://localhost:21324 after starting the containers
