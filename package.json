{
  "name": "classifarr",
  "version": "0.45.4-beta",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "docker:smart": "node scripts/docker-compose-smart.js",
    "docker:smart:build": "node scripts/docker-compose-smart.js build",
    "docker:smart:up": "node scripts/docker-compose-smart.js up -d",
    "docker:smart:down": "docker compose down",
    "docker:smart:rebuild": "npm run docker:smart:down && npm run docker:smart:build && npm run docker:smart:up",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm run lint:server:tests && npm run lint:server:security",
    "lint:server:tests": "cd server && npm run lint:tests",
    "lint:server:security": "cd server && npm run lint:security",
    "lint:client": "cd client && npm run lint",
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "test:coverage": "npm run test:coverage:server && npm run test:coverage:client",
    "test:coverage:server": "cd server && npm run test:coverage",
    "test:coverage:client": "cd client && npm run test:coverage",
    "test:ci": "npm run test:ci:server && npm run test:ci:client && npm run coverage:ratchet:check",
    "test:ci:server": "cd server && npm run test:ci",
    "test:ci:client": "cd client && npm run test:ci",
    "coverage:ratchet:check": "node scripts/check-coverage-ratchet.js",
    "coverage:ratchet:update": "node scripts/update-coverage-baseline.js",
    "check-copyright": "node scripts/check-copyright.js",
    "update-copyright": "node scripts/update-copyright.js",
    "add-copyright-headers": "node scripts/add-copyright-headers.js",
    "generate-contributors": "node scripts/generate-contributors.js",
    "migration:check": "node scripts/check-migrations.js",
    "migration:create": "node scripts/create-migration.js",
    "db:dump-schema": "node scripts/dump-schema.js",
    "lint:docs": "markdownlint-cli2",
    "lint:docs:rag-api": "node scripts/check-rag-api-docs.js"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "markdownlint-cli2": "^0.22.0"
  },
  "overrides": {
    "minimatch": "10.2.4",
    "brace-expansion": "5.0.5",
    "smol-toml": "1.6.1"
  }
}
