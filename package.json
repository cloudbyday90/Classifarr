{
  "name": "classifarr",
  "version": "0.47.5-c.beta",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "docker:smart": "node scripts/docker-compose-smart.mjs",
    "docker:smart:build": "node scripts/docker-compose-smart.mjs build",
    "docker:smart:up": "node scripts/docker-compose-smart.mjs up -d",
    "docker:smart:up:wait": "node scripts/docker-compose-smart.mjs up -d --wait",
    "docker:smart:down": "docker compose down",
    "docker:smart:rebuild": "npm run docker:smart:down && npm run docker:smart:build && npm run docker:smart:up:wait",
    "docker:smart:provenance-rebuild": "node scripts/docker-compose-smart.mjs build --no-cache --require-provenance && node scripts/docker-compose-smart.mjs up -d --no-build --force-recreate --wait",
    "lint": "npm run lint:npm-cli-flags && npm run lint:server && npm run lint:client",
    "lint:npm-cli-flags": "node scripts/check-npm-cli-flags.mjs",
    "lint:server": "npm run lint:server:tests && npm run lint:server:security",
    "lint:server:tests": "cd server && npm run lint:tests",
    "lint:server:security": "cd server && npm run lint:security",
    "lint:client": "cd client && npm run lint",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "typecheck:server": "cd server && npm run typecheck",
    "typecheck:client": "cd client && npm run typecheck",
    "test": "node scripts/run-workspace-tests.mjs test:server test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "test:local:ai-policy-sweep": "node scripts/local-ai-policy-sweep.mjs",
    "test:local:ai-policy-sweep:cleanup": "node scripts/cleanup-local-ai-policy-sweep.mjs --all-reports",
    "policy:storage-closure-evidence": "node scripts/run-policy-storage-closure-evidence.mjs",
    "policy:compatibility-deletion-execution-plan-artifact": "node scripts/generate-policy-compatibility-deletion-execution-plan-artifact.mjs",
    "policy:controlled-compatibility-removal-batch": "node scripts/generate-policy-controlled-compatibility-removal-batch-artifact.mjs",
    "policy:post-removal-verification": "node scripts/generate-policy-post-removal-verification.mjs",
    "policy:next-batch-authorization": "node scripts/generate-policy-next-batch-authorization.mjs",
    "policy:compatibility-removal-completion-audit": "node scripts/generate-policy-compatibility-removal-completion-audit.mjs",
    "policy:compatibility-removal-evidence": "node scripts/generate-policy-compatibility-removal-evidence.mjs",
    "policy:compatibility-deletion-current-inventory": "node scripts/generate-policy-compatibility-deletion-current-inventory.mjs",
    "policy:compatibility-deletion-execution-plan-evidence": "node scripts/generate-policy-compatibility-deletion-execution-plan-evidence-bundle.mjs",
    "policy:compatibility-deletion-maintenance-evidence": "node scripts/run-policy-compatibility-deletion-evidence-maintenance.mjs",
    "policy:compatibility-deletion-preflight-evidence": "node scripts/collect-policy-compatibility-deletion-preflight-evidence.mjs",
    "policy:storage-completion-checkpoint": "node scripts/generate-policy-storage-completion-checkpoint.mjs",
    "policy:storage-final-closure-readout": "node scripts/generate-policy-storage-final-closure-readout.mjs",
    "policy:storage-current-closure-audit": "node scripts/run-policy-storage-current-closure-audit.mjs",
    "policy:storage-closure-requirement-audit": "node scripts/run-policy-storage-closure-requirement-audit.mjs",
    "policy:storage-closure-validation-evidence": "node scripts/generate-policy-storage-closure-validation-evidence.mjs",
    "policy:storage-closure-path-state-evidence": "node scripts/generate-policy-storage-closure-path-state-evidence.mjs",
    "policy:storage-closure-final-removal-audit": "node scripts/generate-policy-storage-closure-final-removal-audit.mjs",
    "policy:storage-closure-instance-evidence": "node scripts/assemble-policy-storage-closure-instance-evidence.mjs",
    "policy:storage-closure-evidence-launcher": "node scripts/run-policy-storage-closure-evidence-launcher.mjs",
    "policy:production-naming-inventory": "node scripts/generate-policy-builder-production-name-inventory.mjs --require-valid",
    "policy:production-naming-gate": "node scripts/run-policy-production-naming-gate.mjs --require-valid",
    "policy:product-language-audit": "node scripts/run-policy-product-language-audit.mjs --require-valid",
    "policy:delivery-term-removal-gate": "node scripts/run-policy-delivery-term-removal-gate.mjs --require-valid",
    "policy:runtime-release-maintenance-audit": "node scripts/run-policy-runtime-release-maintenance-audit.mjs --require-valid",
    "policy:release:operator-decision-metric": "node scripts/generate-policy-operator-decision-metric.mjs",
    "policy:release:installation-evidence": "node scripts/generate-policy-release-installation-evidence.mjs",
    "policy:release:acceptance-readout": "node scripts/generate-policy-release-acceptance-readout.mjs",
    "test:coverage": "node scripts/run-workspace-tests.mjs test:coverage:server test:coverage:client",
    "test:coverage:server": "cd server && npm run test:coverage",
    "test:coverage:client": "cd client && npm run test:coverage",
    "test:ci": "npm run policy:production-naming-gate && npm run policy:product-language-audit && npm run policy:delivery-term-removal-gate && npm run policy:runtime-release-maintenance-audit && npm run typecheck && npm run test:ci:server && npm run test:ci:client && npm run esm:check-static-imports && npm run esm:report-test-mock-shapes:artifact && npm run esm:check-test-mock-shapes && npm run coverage:ratchet:check",
    "test:ci:server": "cd server && npm run test:ci",
    "test:ci:client": "cd client && npm run test:ci",
    "coverage:ratchet:check": "node scripts/check-coverage-ratchet.mjs",
    "coverage:ratchet:update": "node scripts/update-coverage-baseline.mjs",
    "check-copyright": "node scripts/check-copyright.mjs",
    "update-copyright": "node scripts/update-copyright.mjs",
    "add-copyright-headers": "node scripts/add-copyright-headers.mjs",
    "generate-contributors": "node scripts/generate-contributors.mjs",
    "migration:check": "node scripts/check-migrations.mjs",
    "migration:create": "node scripts/create-migration.mjs",
    "db:dump-schema": "node scripts/schema-snapshot-authoritative.mjs --dump",
    "db:dump-schema:container": "node scripts/check-schema-snapshot-container.mjs --dump",
    "db:dump-schema:live": "node scripts/dump-schema.mjs",
    "db:check-schema": "node scripts/schema-snapshot-authoritative.mjs",
    "db:check-schema:container": "node scripts/check-schema-snapshot-container.mjs",
    "db:check-schema:live": "node scripts/check-schema-snapshot.mjs",
    "docker:smoke:pgss": "node scripts/check-pg-stat-startup-smoke.mjs",
    "lint:docs": "markdownlint-cli2",
    "lint:docs:rag-api": "node scripts/check-rag-api-docs.mjs",
    "esm:report-static-imports": "node scripts/report-static-import-candidates.mjs",
    "esm:check-static-imports": "node scripts/report-static-import-candidates.mjs --check",
    "esm:report-test-mock-shapes": "node scripts/report-esm-test-mock-shapes.mjs",
    "esm:report-test-mock-shapes:summary": "node scripts/report-esm-test-mock-shapes.mjs --category-summary",
    "esm:report-test-mock-shapes:json": "node scripts/report-esm-test-mock-shapes.mjs --json",
    "esm:report-test-mock-shapes:artifact": "node scripts/report-esm-test-mock-shapes.mjs --output .tmp/ci/esm-test-mock-shapes.json",
    "esm:check-test-mock-shapes": "node scripts/report-esm-test-mock-shapes.mjs --check",
    "esm:report-test-mock-shapes:strict": "node scripts/report-esm-test-mock-shapes.mjs --strict",
    "esm:report-test-mock-shapes:strict:summary": "node scripts/report-esm-test-mock-shapes.mjs --strict --category-summary",
    "esm:report-test-mock-shapes:strict:json": "node scripts/report-esm-test-mock-shapes.mjs --strict --json",
    "esm:report-test-mock-shapes:strict:artifact": "node scripts/report-esm-test-mock-shapes.mjs --strict --output .tmp/ci/esm-test-mock-shapes-strict.json",
    "esm:check-test-mock-shapes:strict": "node scripts/report-esm-test-mock-shapes.mjs --strict --check"
  },
  "dependencies": {
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.8",
    "smol-toml": "1.6.1",
    "string-width": "8.2.0",
    "js-yaml": "5.2.2",
    "linkify-it": "6.1.0",
    "markdown-it": "^14.3.0",
    "form-data": "^4.0.6",
    "mime-db": "1.54.0",
    "asynckit": "0.5.0"
  }
}
